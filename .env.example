# Example environment file for personal setup.
# Copy this to `.env` and fill in your own values. Do NOT commit `.env`.

# LLM backend: 'auto' = prefer local, fall back to remote if available; 'local' or 'gemini'
LLM_BACKEND=auto

# Optional remote LLM API key (leave blank to stay offline)
GEMINI_API_KEY=

# Local model path (set if you have a HuggingFace-compatible local model folder)
# Example: MODEL_NAME=C:\models\tinyllama_1_1b_chat
MODEL_NAME=

# Embeddings model (sentence-transformers name or local path). Default in code: all-MiniLM-L6-v2
EMBED_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_DB_PATH=./chroma_db

# Email (optional) — use a Gmail App Password (not your account password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DEFAULT_CLIENT_EMAIL=

# Twilio (optional) for live-call demo; leave blank to disable
TWILIO_NUMBER=
TWILIO_CLIENT_NUMBER=
PUBLIC_URL=
TRANSCRIBE_LANG=en-US

# Other runtime options (override in config.py if needed)
# MAX_NEW_TOKENS=320
# GEN_TEMPERATURE=0.6
